# re-evaluation evidence (harness logs); keep manifest/results/summary only
ICLR_experiments/ICLR_reeval/*/jobs/
ICLR_experiments/ICLR_reeval/.*.lock

# Rendered figures are regenerated by ICLR_analysis/Iclr_plot_bank.py; the
# value tables (ICLR_analysis/plots/**/*.csv) are tracked so figure numbers
# are recorded per commit. The four appendix renders already tracked under
# ICLR_analysis/plots/appendix/ stay tracked.
*.png
*.pdf
