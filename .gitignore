# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.python-version
*.egg-info/

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
venv-tb/
.venv/
env/

# ── Experiment outputs (generated at runtime, never commit) ───────────────────
# All collected experiment data lives in data/ (see data/README.md).
# results/ablations, results/tbench, Review1/raw are compatibility symlinks.
data/
results/*
!results/.gitkeep
logs/*
!logs/.gitkeep
graphs/*
!graphs/.gitkeep

# swebench per-run prediction files (written next to workspace root)
preds_*/
preds_*.json
Qwen2.5-Coder-7B-Instruct.*.json
gold.validate-*.json

# ── Editor / OS ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── Claude Code local settings ────────────────────────────────────────────────
.claude/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log

# ── Heavy / scratch dirs (regeneratable or one-machine artifacts) ─────────────
archive/
!scripts/archive/
!scripts/archive/**
temp/
Review1/raw/
Review1/raw
# Per-model aggregated CSVs — partial during sweeps, noisy to track. Sync via
# rsync. Add specific final versions manually with `git add -f` when stable.
Review1/Review1_*.csv

# ── Paper artifacts kept local (regeneratable; would churn the repo) ──────────
PaperSections/
figures/
Review1/figures/
Review1/figures_n100/

# ── Local CSV backups (timestamped snapshots, not history) ────────────────────
*.csv.bak.*
DASHBOARD.html
scripts/notify_slack.py
Review1/archived_experiment_data/
ICLR_results/swebench
ICLR_results/terminalbench/main/qwen35b-smoke
ICLR_results/terminalbench
.tools
venv-glm/
