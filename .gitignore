!/archives/summary_bug_rerun_tooling_20260907_175359_CDT/rerun_list/
!/archives/summary_bug_rerun_tooling_20260907_175359_CDT/rerun_list/*.csv
!/archives/summary_bug_rerun_tooling_20260907_175359_CDT/rerun_list/*.txt

