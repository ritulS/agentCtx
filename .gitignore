# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.python-version
*.egg-info/

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
# The workspace may reuse an existing environment via a symlink.
/venv
venv-tb/
.venv/
env/

# ── Experiment outputs (generated at runtime, never commit) ───────────────────
# All collected experiment data lives in data/ (see data/README.md).
# results/ablations, results/tbench, Review1/raw are compatibility symlinks.
data/
calibration_results/
results/*
!results/.gitkeep
logs/*
!logs/.gitkeep
graphs/*
!graphs/.gitkeep

# swebench per-run prediction files (written next to workspace root)
preds_*/
preds_*.json
Qwen2.5-Coder-7B-Instruct.*.json
gold.validate-*.json

# ── Editor / OS ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── Claude Code local settings ────────────────────────────────────────────────
.claude/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log

# ── Heavy / scratch dirs (regeneratable or one-machine artifacts) ─────────────
archive/
!scripts/archive/
!scripts/archive/**
temp/
Review1/raw/
Review1/raw
# Per-model aggregated CSVs — partial during sweeps, noisy to track. Sync via
# rsync. Add specific final versions manually with `git add -f` when stable.
Review1/Review1_*.csv

# ── Paper artifacts kept local (regeneratable; would churn the repo) ──────────
paper_sections_ICLR/
paper_layout_EMNLP/
figures/
Review1/figures/
Review1/figures_n100/

# ── Local CSV backups (timestamped snapshots, not history) ────────────────────
*.csv.bak.*
DASHBOARD.html
Review1/archived_experiment_data/
ICLR_experiments/swebench
quarantined_results/
venv-glm/
backups/
ICLR_experiments/terminalbench/main/qwen35b-smoke
ICLR_experiments/terminalbench
.tools
venv-glm/
venv-glm-cu129-clean
ICLR_experiments/terminalbench2
analysis/reports

# archives/ holds retired run data moved out of ICLR_experiments by the archive
# scripts (never in git). The notes, task lists and tooling that describe those
# archives are tracked under ICLR_experiments/archive_provenance/.
/archives/

ICLR_experiments/terminalbench
backups/

# issue audits (ICLR_experiments/open_issues/*): keep scripts, README, summary.json and
# the small candidate lists; drop the large derived CSVs.
ICLR_experiments/open_issues/*/runs.csv
ICLR_experiments/open_issues/*/evaluation_classification.csv
ICLR_experiments/open_issues/*/evaluation_checks.csv
ICLR_experiments/open_issues/*/review_candidates.csv
ICLR_experiments/open_issues/*/reevaluation_candidates_combined.csv

# Keep the canonical analysis snapshot; ignore filtered result copies.
/adaptive_context_management_analysis/results/*
!/adaptive_context_management_analysis/results/all/
!/adaptive_context_management_analysis/results/all/**
!/adaptive_context_management_analysis/results/model=qwen35b__primitive=fc/
!/adaptive_context_management_analysis/results/model=qwen35b__primitive=fc/**

# re-evaluation evidence (harness logs); keep manifest/results/summary only
ICLR_experiments/reeval_evidence/*/jobs/
ICLR_experiments/reeval_evidence/.*.lock

# Rendered figures and their value CSVs are regenerated by
# ICLR_experiments/plotting/plot_bank.py into ICLR_experiments/plotting/plots/.
*.png
*.pdf
ICLR_experiments/plotting/plots/
