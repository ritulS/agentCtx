ICLR_experiments/issue/*/evaluation_classification.csv
ICLR_experiments/issue/*/evaluation_checks.csv
ICLR_experiments/issue/*/review_candidates.csv
ICLR_experiments/issue/*/reevaluation_candidates_combined.csv

# ICLR_analysis notes are hand-written failure analyses (not regeneratable);
# only the 32MB outcome dump is excluded.
ICLR_experiments/ICLR_analysis/outcome/

# Keep the canonical analysis snapshot; ignore filtered result copies.
/adaptive_context_management_analysis/results/*
!/adaptive_context_management_analysis/results/all/
!/adaptive_context_management_analysis/results/all/**
!/adaptive_context_management_analysis/results/model=qwen35b__primitive=fc/
